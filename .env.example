# ── DATABASE ──────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/mrwilson?schema=public"

# ── JWT ───────────────────────────────────────────────
JWT_SECRET="replace-with-64-char-random-string"
JWT_REFRESH_SECRET="replace-with-different-64-char-random-string"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# ── SERVER ────────────────────────────────────────────
PORT=3001
NODE_ENV="development"
FRONTEND_URLS="http://localhost:3000"

# ── STRIPE (fill in when payment provider is chosen) ──
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── AWS S3 / CLOUDFLARE R2 ────────────────────────────
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ENDPOINT=""


# ── EMAIL (RESEND) ────────────────────────────────────
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@mrwilson.com"
ADMIN_EMAIL="joseph@mrwilson.com"

# ── REDIS ─────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# Public images use a CDN/base URL serving only the public/ prefix
S3_PUBLIC_BASE_URL=""
S3_MAX_UPLOAD_BYTES=5368709120

# Custom FFmpeg video worker (separate from the API and email worker)
API_PUBLIC_URL="http://localhost:3001"
FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"
VIDEO_MAX_DURATION_SECONDS=14400
VIDEO_MAX_OUTPUT_BYTES=10737418240
VIDEO_TRANSCODE_TIMEOUT_SECONDS=21600
VIDEO_TRANSCODE_THREADS=2
VIDEO_TRANSCODE_ATTEMPTS=3
VIDEO_PLAYBACK_TTL_SECONDS=3600
